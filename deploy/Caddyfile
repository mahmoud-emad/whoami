# Whoami portfolio — mahmoud-emad.dev
#
# Caddy is the only publicly reachable process. The Node backend listens on 127.0.0.1:3000 and
# is never exposed directly: there is no API subdomain and no open port 3000. The SPA and the
# API share this one origin, so /api/* is reachable only through here.
{
	email admin@mahmoud-emad.dev
}

mahmoud-emad.dev, www.mahmoud-emad.dev {
	encode zstd gzip

	header {
		# HSTS: 1 year, including subdomains.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Vuetify injects styles at runtime, so style-src needs unsafe-inline.
		# img-src also allows https: because a post can reference an image hosted elsewhere, and
		# without it those come out as broken boxes. It is the one relaxation here: scripts,
		# styles, fonts and connections all stay same-origin, so an external image is an image and
		# nothing more. Post bodies are owner-authored, and the guestbook is not markdown, so a
		# visitor cannot get a remote URL onto the page.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Uploaded files are immutable once written — their names are unique.
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=2592000"

	# Hashed bundle filenames can be cached indefinitely.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mib
			roll_keep 5
		}
	}
}
