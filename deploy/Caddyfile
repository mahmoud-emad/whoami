# whoami portfolio — mahmoud-emad.dev
#
# Caddy is the only publicly reachable process. The Node backend listens on 127.0.0.1:3000 and
# is never exposed directly: there is no API subdomain and no open port 3000. The SPA and the
# API share this one origin, so /api/* is reachable only through here.
{
	email admin@mahmoud-emad.dev
}

mahmoud-emad.dev, www.mahmoud-emad.dev {
	encode zstd gzip

	header {
		# HSTS: 1 year, including subdomains.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		# Vuetify injects styles at runtime, so style-src needs unsafe-inline.
		# img-src also allows https: because a post can reference an image hosted elsewhere, and
		# without it those come out as broken boxes. It is the one relaxation here: scripts,
		# styles, fonts and connections all stay same-origin, so an external image is an image and
		# nothing more. Post bodies are owner-authored, and the guestbook is not markdown, so a
		# visitor cannot get a remote URL onto the page.
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Uploaded files are immutable once written — their names are unique.
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=2592000"

	# Hashed bundle filenames can be cached indefinitely.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else is the SPA entry point, and it must always be revalidated.
	#
	# index.html names the hashed bundles, so a stale copy of it asks for filenames the last
	# deploy deleted and the app never boots. Without an explicit header the entry point had
	# none at all, which leaves freshness to browser heuristics — a page that keeps loading
	# assets that no longer exist, with no way for the visitor to know a reload would fix it.
	#
	# `no-cache` is revalidate-before-use, not "do not store": the ETag still makes it a 304
	# on every deploy that did not change it, so this costs a conditional request, not a
	# re-download.
	@html not path /assets/* /uploads/* /api/*
	header @html Cache-Control "no-cache"

	reverse_proxy 127.0.0.1:3000 {
		# Never let a "not found" inherit one of the cache headers above.
		#
		# The matchers are on the request path, so they apply whatever the answer turns out to
		# be: a 404 for /assets/* was being handed back as immutable for a year. Most of the
		# time that is harmless, because a hashed filename that is missing is missing forever
		# — but a request that lands mid-deploy, after index.html has been replaced and before
		# its bundles have, would cache the miss for an asset that exists moments later, and
		# that visitor stays broken until they clear their cache.
		@notfound status 404
		handle_response @notfound {
			header Cache-Control "no-store"
			copy_response
		}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mib
			roll_keep 5
		}
	}
}
