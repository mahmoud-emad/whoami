# Copy to .env for local development:  cp .env.example .env
#
# ---------------------------------------------------------------------------
# HOW CONFIGURATION WORKS HERE
#
#   Environment variables SEED the site on its FIRST BOOT ONLY.
#   The admin dashboard OWNS everything afterwards.
#
# On startup the server fills any field in backend/config.json that is still
# empty from the variables below, then never touches that field again. Editing
# a value here after the first boot changes nothing — the dashboard is the
# source of truth from then on, and a stale .env can never overwrite it.
#
# In DEVELOPMENT nothing below is mandatory: missing values only print a
# warning, so `yarn server` works on a fresh clone. In PRODUCTION the three
# variables marked REQUIRED must be present or the server refuses to start.
# See .env.production.example for the deployment copy of this file.
# ---------------------------------------------------------------------------


# --- Frontend build ---------------------------------------------------------
# Base URL of the backend API, baked into the frontend bundle at build time.
# Development: the backend runs on its own port, so point at it explicitly.
# Production:  leave this EMPTY. Express serves the built frontend on the same
#              origin as the API, so relative URLs are correct and nothing has
#              to be rebuilt when the domain changes.
VITE_SERVER_URL=http://localhost:3000


# --- Server runtime ---------------------------------------------------------
# PORT must be a whole number between 1 and 65535, or the server exits.
PORT=3000
HOST=0.0.0.0
# NODE_ENV=development


# --- REQUIRED in production (optional in development) -----------------------
# Admin password for the dashboard, minimum 8 characters. Used ONLY to seed
# config.json on the very first boot: it is immediately turned into a salted
# scrypt hash and the plaintext is never stored. If it is unset on first boot
# the server generates one and prints it to the log exactly once. Once a
# signature exists you may drop this variable — change the password from the
# dashboard instead.
ADMIN_SIGNATURE=

# Your display name. Seeds profile.fullName, profile.brand.displayName,
# profile.brand.copyrightOwner and the SEO <title> (meta.title).
SITE_OWNER=

# Public URL of the site; must be absolute. Seeds meta.siteUrl, which the
# server uses to build canonical and Open Graph URLs for crawlers.
SITE_URL=http://localhost:5173


# --- Optional everywhere ----------------------------------------------------
# Job title shown under your name. Seeds profile.role.
SITE_ROLE=

# Short handle, e.g. "@ada". Seeds profile.brand.handle.
SITE_HANDLE=

# Public contact email. Seeds profile.socials.email.
SITE_EMAIL=

# GitHub profile URL. Seeds profile.socials.githubUrl, configuration.githubURL
# and profile.brand.handleUrl.
SITE_GITHUB=

# LinkedIn profile URL. Seeds profile.socials.linkedinUrl.
SITE_LINKEDIN=

# X/Twitter profile URL. Seeds profile.socials.xUrl.
SITE_X=

# IANA timezone, e.g. "Europe/Berlin" or "Africa/Cairo". Validated at startup —
# an unrecognised zone is a typo and is reported. Seeds profile.socials.timezone.
SITE_TIMEZONE=

# One-line description of the site, used for the meta description and link
# previews. Seeds meta.description.
SITE_DESCRIPTION=

# Guestbook anti-bot challenge. The question is public; the ANSWER never leaves
# the server — GET /settings exposes only the question, and POST /guestbooks
# checks the answer server-side (trimmed, case-insensitive). Leaving the answer
# empty disables the check. Seeds configuration.antiBot.question/answer.
ANTIBOT_QUESTION=
ANTIBOT_ANSWER=

# IndieWeb webring. Set to 1 to show the "← IndieWeb Webring →" links in the
# footer. Register the site at https://xn--sr8hvo.ws/ first; the ring works out
# which member sent a visitor from the HTTP referrer, so there is no slug or key
# to configure here. Seeds indieweb.webring.enabled.
# Note: unlike the text variables, this one re-seeds while the field is still
# false, so remove it once the site is up if you later turn the ring off from
# the dashboard. Accepts 1/0, true/false, yes/no, on/off.
# WEBRING_ENABLED=1


# --- Reverse proxy / CORS ---------------------------------------------------
# Set to 1 when running behind nginx, Caddy or Cloudflare so rate limiting sees
# the real client IP instead of the proxy's.
# TRUST_PROXY=1

# Only needed if the frontend is hosted on a DIFFERENT origin than this API.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
