# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode

# Environment — never commit these; the .example files are the templates
.env
.env.*
!.env.example
!.env.production.example

# Runtime state. config.json holds the admin signature hash and the live site content, so it is
# per-deployment data, not source; backend/config.example.json is the template it seeds from.
backend/db.json
backend/config.json
# Hand-made backups of the above (config.json.bak, config.json.pre-theme-reset). Same contents,
# same signature hash, so they are just as much a credential.
backend/config.json.*
backend/db.json.*

# Visitor- and admin-uploaded files
backend/uploads/*
!backend/uploads/.gitkeep

# Backup tarballs written by the compose backup service. They contain the signature hash and all
# of your content — treat them as credentials, and never commit them.
backups/

# Compiled backend
backend/dist
