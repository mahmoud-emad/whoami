{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build && yarn build:server",
    "preview": "vite preview",
    "server": "yarn build:server && node backend/dist/index.js",
    "start": "NODE_ENV=production node backend/dist/index.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "typecheck": "vue-tsc -b && tsc -p backend/tsconfig.json --noEmit",
    "build:server": "tsc -p backend/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5",
    "@fontsource/ibm-plex-mono": "5",
    "@fontsource/ibm-plex-sans": "5",
    "@mdi/font": "^7.4.47",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/quill": "^2.0.14",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mdi": "^2.2.43",
    "multer": "^1.4.5-lts.1",
    "pinia": "^2.1.7",
    "ts-node": "^10.9.2",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vue3-markdown": "^1.1.9",
    "vuetify": "^3.6.5",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^21.1.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitejs/plugin-vue-jsx": "^3.1.0",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.5",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "jsdom": "^24.0.0",
    "npm-run-all2": "^6.1.2",
    "prettier": "^3.2.5",
    "typescript": "^5.7.3",
    "vite": "^5.2.8",
    "vite-plugin-vue-devtools": "^7.0.25",
    "vite-plugin-vuetify": "^2.0.3",
    "vitest": "^1.4.0",
    "vue-tsc": "^2.0.11"
  }
}
