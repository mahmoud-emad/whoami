{
  "name": "whoami",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "yarn workspace whoami-frontend dev",
    "server": "yarn workspace whoami-backend dev",
    "build": "yarn build:frontend && yarn build:server",
    "build:frontend": "yarn workspace whoami-frontend build",
    "build:server": "yarn workspace whoami-backend build",
    "start": "yarn workspace whoami-backend start",
    "preview": "yarn workspace whoami-frontend preview",
    "typecheck": "yarn workspace whoami-frontend typecheck && yarn workspace whoami-backend typecheck",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "test": "yarn workspace whoami-frontend test"
  },
  "devDependencies": {
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "prettier": "^3.2.5",
    "typescript": "^5.7.3"
  }
}
