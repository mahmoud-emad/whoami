# Server-side environment for a production deploy. These are read by backend/server.cjs at
# runtime — they are NOT baked into the frontend bundle. Copy to .env.production (gitignored)
# or set them in your systemd unit / container environment.
#
# ---------------------------------------------------------------------------
# ENV SEEDS, THE DASHBOARD OWNS
#
# Everything below is used ONLY to fill fields in backend/config.json that are
# still empty — on the first boot of a new deployment. After that the admin
# dashboard is the single source of truth: the server never overwrites a value
# the owner has edited, so an out-of-date .env.production is harmless.
#
# The variables marked REQUIRED are enforced. With NODE_ENV=production the
# server VALIDATES them before it binds a port and EXITS with a message naming
# each missing or invalid one — a deploy that is misconfigured must fail loudly
# rather than come up as a nameless site with an unreachable dashboard.
# ---------------------------------------------------------------------------

NODE_ENV=production

# Port and interface the server binds to. PORT must be a whole number between
# 1 and 65535 or startup fails.
PORT=3000
HOST=0.0.0.0


# === REQUIRED =============================================================
# Missing or invalid values here abort startup.

# REQUIRED — the admin signature (dashboard password), minimum 8 characters.
# Used ONLY to seed config.json on the very first boot. It is immediately
# converted to a salted scrypt hash; the plaintext is never stored. If this is
# unset on first boot, the server generates a random signature and prints it
# once to the log. Once config.json holds a signature this variable is no
# longer required — change the password from the dashboard, not here.
ADMIN_SIGNATURE=

# REQUIRED — your display name. Seeds profile.fullName,
# profile.brand.displayName, profile.brand.copyrightOwner and meta.title.
SITE_OWNER=

# REQUIRED — the public URL of the site; must parse as an absolute URL.
# Seeds meta.siteUrl, which the server uses to render canonical and Open Graph
# URLs into the HTML head so crawlers and link previews resolve correctly.
SITE_URL=https://example.com


# === OPTIONAL =============================================================
# Omitted values simply leave the corresponding config field empty, to be
# filled in from the dashboard later. A value that IS set but malformed
# (e.g. a bogus timezone) still aborts startup — that is a typo, not a choice.

# Job title shown under your name. Seeds profile.role.
SITE_ROLE=

# Short handle, e.g. "@ada". Seeds profile.brand.handle.
SITE_HANDLE=

# Public contact email. Seeds profile.socials.email.
SITE_EMAIL=

# GitHub profile URL. Seeds profile.socials.githubUrl, configuration.githubURL
# and profile.brand.handleUrl.
SITE_GITHUB=

# LinkedIn profile URL. Seeds profile.socials.linkedinUrl.
SITE_LINKEDIN=

# X/Twitter profile URL. Seeds profile.socials.xUrl.
SITE_X=

# IANA timezone, e.g. "Europe/Berlin". Validated with Intl.DateTimeFormat.
# Seeds profile.socials.timezone.
SITE_TIMEZONE=

# One-line description of the site. Seeds meta.description, which is rendered
# into <meta name="description">, og:description and twitter:description.
SITE_DESCRIPTION=

# Guestbook anti-bot challenge. The question is public and is served in
# GET /settings; the ANSWER is stripped from every public response and is
# checked server-side in POST /guestbooks (trimmed, case-insensitive).
# Leave the answer empty to disable the check.
# Seeds configuration.antiBot.question and configuration.antiBot.answer.
ANTIBOT_QUESTION=
ANTIBOT_ANSWER=

# A public hint about the SHAPE of the answer, shown under the guestbook field —
# "one word, lowercase", "a number". Never the answer itself.
ANTIBOT_EXAMPLE=

# IndieWeb webring. Set to 1 to show the "← IndieWeb Webring →" links in the
# footer. Register the site at https://xn--sr8hvo.ws/ first. The ring exposes
# bare /previous and /next endpoints and identifies the site from the HTTP
# referrer, so there is no slug or key to set. Seeds indieweb.webring.enabled;
# the name and base URL are edited from the dashboard's "Site meta" tab.
# Accepts 1/0, true/false, yes/no, on/off. Unlike the text variables this one
# re-seeds while the field is still false, so drop it from the environment once
# the site is configured.
# WEBRING_ENABLED=1


# === Reverse proxy / CORS =================================================

# Set to 1 when running behind nginx, Caddy, Cloudflare or any other reverse proxy, so that
# rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=1

# Only needed if the frontend is hosted on a DIFFERENT origin than this API. Leave empty for
# the standard single-server setup, which is same-origin and needs no CORS exceptions.
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
